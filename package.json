{
  "name": "peak-launcher",
  "productName": "Peak Launcher",
  "version": "1.7.2",
  "description": "Nowoczesny launcher Minecraft z motywem Góry PEAK, łatwym dodawaniem modów, wszystkimi wersjami oraz automatyczną instalacją Javy i Fabrica.",
  "author": "Peak Launcher",
  "repository": "https://github.com/latajoncy82-svg/peak-launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "python scripts/build-icons.py",
    "verify:engine": "node scripts/verify-engine.js",
    "capture": "electron . --capture-screenshots",
    "website": "node scripts/serve-website.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.peaklauncher.app",
    "productName": "Peak Launcher",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon-64.png",
      "assets/peak-dns.jar",
      "assets/peak-client-mc26.jar",
      "assets/peak-client-mc1214.jar",
      "assets/peak-ui-pack.zip"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Peak Launcher",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Peak-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Peak-Launcher-Portable-${version}.${ext}"
    }
  }
}
